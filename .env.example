# Copy to .env and fill in. NEVER commit .env.
# A leaked key in a public repo is a disqualification risk.
# The agent loads this file automatically; real environment variables win.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Super for gate and demo runs; Nano (nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B) is
# ~5x cheaper for development. `--model nano|super` overrides this per run.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Hard cap on total Token Factory spend recorded in the ledger, in USD.
AERO_SPEND_CAP_USD=5.0
AERO_SPEND_LEDGER=runs/spend.jsonl

AERO_SERVICE_URL=http://localhost:8000
AERO_RUNLOG_DIR=runs/logs

# Empty = serve the stub. Point at a checkpoint to serve the real model.
AERO_CHECKPOINT=

# ---- Hosted service (src/service). See src/service/DEPLOY.md. ----
# In Docker, pass these with --env-file from a host file (unquoted values).
# Exact origins of the frontend, comma-separated; '*' is refused.
AERO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Bearer token that lifts public limits (>= 16 chars). Empty = no admin.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AERO_ADMIN_TOKEN=
# 1/0: may callers without the token start agent runs.
AERO_PUBLIC_RUNS=1
AERO_MAX_CONCURRENT_RUNS=1
AERO_PUBLIC_MAX_ITERATIONS=25
AERO_ADMIN_MAX_ITERATIONS=50
# Spend ceilings in USD: per public run, per admin run, all public runs per UTC day.
AERO_PUBLIC_RUN_BUDGET_USD=0.10
AERO_ADMIN_RUN_BUDGET_USD=0.50
AERO_PUBLIC_DAILY_BUDGET_USD=1.00
# POST /evaluate, /compare, /runs per client IP per minute (0 = off).
AERO_RATE_LIMIT_PER_MINUTE=120
# Largest accepted request body in bytes (>= 1024); larger gets 413.
AERO_MAX_BODY_BYTES=65536
# 1 only behind your own reverse proxy (e.g. Caddy) with the app port not
# publicly reachable: the client IP is then the last X-Forwarded-For entry.
AERO_TRUST_PROXY=0
