# Copy to .env and fill in. NEVER commit .env.
# A leaked key in a public repo is a disqualification risk.
# The agent loads this file automatically; real environment variables win.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Super for gate and demo runs; Nano (nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B) is
# ~5x cheaper for development. `--model nano|super` overrides this per run.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Hard cap on total Token Factory spend recorded in the ledger, in USD.
AERO_SPEND_CAP_USD=5.0
AERO_SPEND_LEDGER=runs/spend.jsonl

AERO_SERVICE_URL=http://localhost:8000
AERO_RUNLOG_DIR=runs/logs

# Empty = serve the stub. Point at a checkpoint to serve the real model.
AERO_CHECKPOINT=
